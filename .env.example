# PostgreSQL
POSTGRES_USER=dtc
POSTGRES_PASSWORD=dtc_secret
POSTGRES_DB=platform

# Redis
REDIS_URL=redis://redis:6379/0

# MinIO (S3-compatible artifact store)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123

# MLflow
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_EXPERIMENT_NAME=bank-marketing
MLFLOW_REGISTERED_MODEL_NAME=bank-marketing-classifier

# Platform
PLATFORM_SECRET_KEY=change-me-in-production
WEBHOOK_SECRET=change-me-in-production

# Agent LLM (choose one)
GROQ_API_KEY=
# OPENAI_API_KEY=

# Agent checkpoint database
AGENT_CHECKPOINT_DB_URL=postgresql://dtc:dtc_secret@postgres:5432/agent_checkpoints

# Drift thresholds
PSI_WARNING_THRESHOLD=0.1
PSI_CRITICAL_THRESHOLD=0.2
CHI2_P_VALUE_THRESHOLD=0.05
